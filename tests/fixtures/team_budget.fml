model demo.team_budget
// Multi-file budget: each team's spend lives in its own file, owned by
// that team's lead. Grid edits are routed into the owning file by the
// include source map — the master file never changes when a team edits
// its numbers, so git merges across teams are conflict-free.

calendar plan = yearly 2026 .. 2029
currency kEUR

input budget_cap : kEUR flow over plan = { 2026: 1_700, 2027: 1_850, 2028: 1_950, 2029: 2_050 }

include "team_marketing.fml"
include "team_engineering.fml"
include "team_operations.fml"

total_expenses : kEUR flow over plan = marketing_spend + engineering_spend + operations_spend
headroom : kEUR flow over plan = budget_cap - total_expenses

assert within_envelope over plan : total_expenses <= budget_cap
