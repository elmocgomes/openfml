model golden.solar_pf
// FAST-style single-asset project finance with sculpted debt.
// Golden values: finmodel-lang-research/09-fast-sculpting-golden.md
// Amounts in kEUR (scaled currency units are a later phase — kEUR is the
// declared currency here, so tariffs are kEUR/MWh).

calendar qtr  = quarterly 2026-Q1 .. 2041-Q4
period constr = 2026-Q1 .. 2026-Q4
period ops    = 2027-Q1 .. 2041-Q4
period tenor  = 2027-Q1 .. 2036-Q4
currency kEUR
unit MWh

// ── Inputs ──────────────────────────────────────────────────────────
input capex : kEUR flow over constr
    = { 2026-Q1: 9_000, 2026-Q2: 21_000, 2026-Q3: 21_000, 2026-Q4: 9_000 }
input production : MWh flow over ops = 32_000 * (1 - 0.5%) ^ (year(t) - 2027)
input tariff : kEUR/MWh over ops = 0.060 * (1 + 2%) ^ (year(t) - 2027)
input opex : kEUR flow over ops = 450 * (1 + 2.5%) ^ (year(t) - 2027)
input r_q          : rate  = 6% / 4
input dscr_target  : ratio = 1.30
input gearing_max  : rate  = 75%
input upfront_pct  : rate  = 2%

// ── Operations ──────────────────────────────────────────────────────
revenue = production * tariff
cfads : kEUR flow over ops = revenue - opex

// ── Debt schedule: plain recursion once the facility is known ───────
debt_balance : kEUR stock over tenor init: debt_facility
    = prev(debt_balance) - principal
interest : kEUR flow over tenor = r_q * prev(debt_balance)
principal : kEUR flow over tenor
    = min(cfads / dscr_target - interest, prev(debt_balance))
debt_service : kEUR flow over tenor = interest + principal
dscr : ratio over tenor = cfads / debt_service

// ── DSRA: forward-looking window ────────────────────────────────────
dsra_target : kEUR flow over tenor = sum(debt_service[t+1 .. t+2])
dsra_move : kEUR flow over tenor
    = dsra_target - (prev(dsra_target) init dsra_initial)

// ── Construction & funding ──────────────────────────────────────────
idc : kEUR flow over constr = r_q * prev(debt_drawn)
funding_need : kEUR flow over constr
    = capex + idc + upfront_fee when first(constr)
                  + dsra_initial when last(constr)
debt_draw : kEUR flow over constr = debt_share * funding_need
debt_drawn : kEUR stock over constr init: 0 = prev(debt_drawn) + debt_draw

uses         : kEUR = sum[constr](funding_need)
upfront_fee  : kEUR = upfront_pct * debt_facility
dsra_initial : kEUR = sum(debt_service[tenor.start .. tenor.start + 1])
debt_share   : rate = debt_facility / uses
equity       : kEUR = uses - debt_facility

debt_facility : kEUR
    = min(gearing_max * uses,
          npv(r_q, cfads / dscr_target over tenor))

// ── The knot: tearing variables close every circularity ─────────────
solve sizing {
  relax uses init sum[constr](capex)
  relax debt_facility init 45_000
  tolerance 0.01 kEUR
  max_iterations 50
}

// ── Equity & results ────────────────────────────────────────────────
equity_cf : kEUR flow over qtr = match t {
  in constr      -> 0 - (funding_need - debt_draw)
  in tenor       -> cfads - debt_service - dsra_move
  in ops \ tenor -> cfads
}
equity_irr : rate = annualize(irr(qtr, equity_cf))

// ── Invariants ──────────────────────────────────────────────────────
assert full_amortization : debt_balance[tenor.end] == 0 kEUR ± 0.05
assert draws_tie         : debt_drawn[constr.end] == debt_facility ± 0.05
assert sources_are_uses  : debt_facility + sum[constr](0 - equity_cf) == uses ± 0.05
assert sculpt_holds over tenor : dscr >= dscr_target - 0.0001

// ── Scenarios ───────────────────────────────────────────────────────
scenario CheapDebt from Base {
  r_q = 5% / 4
}
scenario LowTariff from Base {
  tariff = 0.050 * (1 + 2%) ^ (year(t) - 2027)
}
