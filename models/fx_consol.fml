model golden.fx_consol
// Two-entity FX consolidation (IAS 21 current-rate method).
// Golden values: finmodel-lang-research/10-fx-consolidation-golden.md
// Amounts in kEUR / kUSD. The `consolidate`/`eliminate` sugar from doc 10
// is deferred; translation and eliminations are written explicitly with
// the conversion operator, which exercises the same semantics.

calendar m = monthly 2026-01 .. 2026-12
dimension Entity = tree { Group -> { PT_Co, US_Co } }
currency kEUR
unit kUSD, MWh
functional Entity = { PT_Co: kEUR, US_Co: kUSD }

// ── FX rates (observable sugar deferred: plain measures) ────────────
input usd_eur_hist : kUSD/kEUR = 1.08
input usd_eur_close : kUSD/kEUR over m
    = { 2026-01: 1.09, 2026-02: 1.10, 2026-03: 1.12, 2026-04: 1.11,
        2026-05: 1.13, 2026-06: 1.14, 2026-07: 1.13, 2026-08: 1.15,
        2026-09: 1.14, 2026-10: 1.15, 2026-11: 1.16, 2026-12: 1.16 }
usd_eur_avg : kUSD/kEUR over m
    = ((prev(usd_eur_close) init usd_eur_hist) + usd_eur_close) / 2

// ── Intercompany objects ────────────────────────────────────────────
input ic_loan : kEUR = 5_000                       // EUR-denominated, PT → US
input ic_goods : kEUR flow over m = 200            // trade, settled monthly @ avg
ic_interest : kEUR flow over m = ic_loan * 6% / 12

// ── Entity books, functional ("local") currency ─────────────────────
revenue : local flow over Entity, m = match Entity {
  PT_Co -> 800 + ic_goods
  US_Co -> 400
}
costs : local flow over Entity, m = match Entity {
  PT_Co -> 600
  US_Co -> 80 + (ic_goods + ic_interest) in kUSD at usd_eur_avg
}
// EUR-denominated payable held by the USD-functional entity ⇒ monthly
// remeasurement (auto-derivation from denomination typing is a v2 goal).
fx_remeasure : local flow over Entity, m = match Entity {
  US_Co -> 0 - ic_loan * (usd_eur_close - (prev(usd_eur_close) init usd_eur_hist))
  else  -> 0
}
net_income : local flow over Entity, m
    = revenue - costs
      + (match Entity { PT_Co -> ic_interest, else -> 0 })
      + fx_remeasure

cash : local stock over Entity, m
    init: match Entity { PT_Co -> 1_000, US_Co -> 800 }
    = prev(cash) + net_income - fx_remeasure       // remeasurement is non-cash
ppe : local over Entity = match Entity { PT_Co -> 3_000, US_Co -> 6_000 }
ic_receivable : local over Entity = match Entity { PT_Co -> ic_loan, else -> 0 }
liabs : local flow over Entity, m
    = match Entity { US_Co -> ic_loan * usd_eur_close, else -> 0 }
equity0 : local over Entity = match Entity { PT_Co -> 9_000, US_Co -> 1_400 }
retained : local stock over Entity, m init: 0 = prev(retained) + net_income

assets : local flow over Entity, m = cash + ppe + ic_receivable

assert entity_books over m : assets == liabs + equity0 + retained ± 0.001

// ── Translation to presentation currency (kEUR) ─────────────────────
// Flows at average, stocks at closing, opening equity at historical —
// the kind-aware `consolidate` defaults of doc 10, written out.
ni_tr : kEUR flow over Entity, m = match Entity {
  PT_Co -> net_income
  US_Co -> net_income in kEUR at usd_eur_avg
}
assets_tr : kEUR flow over Entity, m = match Entity {
  PT_Co -> assets
  US_Co -> assets in kEUR at usd_eur_close
}
liabs_tr : kEUR flow over Entity, m = match Entity {
  PT_Co -> liabs
  US_Co -> liabs in kEUR at usd_eur_close        // == ic_loan exactly, by identity
}
eq0_tr : kEUR over Entity = match Entity {
  PT_Co -> equity0
  US_Co -> equity0 in kEUR at usd_eur_hist
}
re_tr : kEUR stock over Entity, m init: 0 = prev(re_tr) + ni_tr

// CTA as the translation residual (zero for PT_Co by construction).
cta : kEUR flow over Entity, m = assets_tr - liabs_tr - eq0_tr - re_tr

// ── Consolidation: Group aggregation + explicit eliminations ────────
cons_revenue : kEUR flow over m = revenue_tr[Group] - ic_goods
revenue_tr : kEUR flow over Entity, m = match Entity {
  PT_Co -> revenue
  US_Co -> revenue in kEUR at usd_eur_avg
}
cons_ni : kEUR flow over m = ni_tr[Group]          // trade & interest elims net 0
grp_assets : kEUR flow over m = assets_tr[Group] - ic_loan
grp_liabs  : kEUR flow over m = liabs_tr[Group] - ic_loan
grp_equity : kEUR flow over m = eq0_tr[Group] + re_tr[Group] + cta[Group]

eliminate loan over m : liabs_tr[US_Co] against ic_receivable[PT_Co] ± 0.000001
assert group_ties over m : grp_assets - grp_liabs == grp_equity ± 0.001

// ── CTA double-derivation (the direct IAS 21 movement formula) ──────
na_us : kUSD flow over m = assets[US_Co] - liabs[US_Co]
ni_us : kUSD flow over m = net_income[US_Co]
cta_us : kEUR flow over m = cta[US_Co]
d_cta_direct : kEUR flow over m
    = (prev(na_us) init 1_400) * (1 / usd_eur_close - 1 / (prev(usd_eur_close) init usd_eur_hist))
      + ni_us * (1 / usd_eur_close - 1 / usd_eur_avg)
assert cta_direct over m : cta_us - (prev(cta_us) init 0) == d_cta_direct ± 0.001

// ── FY totals ───────────────────────────────────────────────────────
fy_revenue : kEUR = sum[m](cons_revenue)
fy_ni      : kEUR = sum[m](cons_ni)
fy_fx      : kEUR = sum[m](fx_remeasure[US_Co] in kEUR at usd_eur_avg)
